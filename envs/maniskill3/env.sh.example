# Source in any shell that runs ManiSkill3. Edit the three paths for your machine.
export MS_ENV=${MS_ENV:-$HOME/miniforge3/envs/maniskill3}          # conda env of section 1
export NV_LIB=${NV_LIB:-/usr/lib/x86_64-linux-gnu}                  # dir holding libGLX_nvidia.so.0, libnvidia-rtcore*, libnvoptix*
export MS_ASSET_DIR=${MS_ASSET_DIR:-$HOME/data/maniskill3_assets}   # assets downloaded on first use (not a RAM-backed /tmp)
export PATH=$MS_ENV/bin:$PATH
export LD_LIBRARY_PATH=$NV_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
# ICD json written next to this file on first use; library_path must be the driver's libGLX_nvidia.so.0
ICD=$(dirname "${BASH_SOURCE[0]}")/nvidia_icd.json
[ -f "$ICD" ] || printf '{"file_format_version": "1.0.1", "ICD": {"library_path": "%s/libGLX_nvidia.so.0", "api_version": "1.4.312"}}\n' "$NV_LIB" > "$ICD"
export VK_ICD_FILENAMES=$ICD
unset DISPLAY   # an unreachable X server makes the NVIDIA Vulkan ICD hang
